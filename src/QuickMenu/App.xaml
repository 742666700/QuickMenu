<Application x:Class="QuickMenu.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Desktop row: soft hover wash, clay bar and tint when selected. -->
      <DataTemplate x:Key="DesktopItemTemplate">
        <Grid x:Name="DesktopRow" Background="Transparent" ToolTip="{Binding Name}">
          <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="10" Opacity="0"/>
          <Border x:Name="Selected" Background="{DynamicResource SelectedBrush}" CornerRadius="10" Visibility="Collapsed"/>
          <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="0,18" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
          <Grid Margin="12,11,10,11">
            <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
            <Grid Width="44" Height="44">
              <TextBlock Text="&#xE8A5;" Style="{StaticResource MissingIconGlyph}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
              <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding DisplayType}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="PinBadge" Grid.Column="2" Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{DynamicResource AccentBrush}" Opacity="0.85" Visibility="Collapsed" VerticalAlignment="Center"/>
          </Grid>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter TargetName="PinBadge" Property="Visibility" Value="Visible"/></DataTrigger>
          <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.1"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
            <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
          </DataTrigger>
          <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
            <Setter TargetName="Selected" Property="Visibility" Value="Visible"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
          </DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>

      <!-- Running app row. Terminate_Click lives in App.xaml.cs, so this template stays here. -->
      <DataTemplate x:Key="AppRowTemplate">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Width="40" Height="40" Background="{DynamicResource IconPlateBrush}" CornerRadius="10">
            <Grid Width="28" Height="28">
              <TextBlock Text="&#xE8A5;" Style="{StaticResource MissingIconGlyph}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
              <Image Source="{Binding Icon}" Stretch="Uniform"/>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="310"/>
              <Border x:Name="ForegroundBadge" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="7,0,7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="{DynamicResource S.Template.CurrentWindow}" FontSize="10.5" FontWeight="Medium" Foreground="{DynamicResource AccentTextBrush}"/>
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
          <Button Grid.Column="2" Style="{StaticResource TerminateButton}" Content="{DynamicResource S.Template.EndProcess}" IsEnabled="{Binding CanTerminate}" Tag="{Binding}" Click="Terminate_Click" Padding="12,6" FontSize="12" ToolTip="{DynamicResource S.Template.EndProcessTip}"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsForeground}" Value="True"><Setter TargetName="ForegroundBadge" Property="Visibility" Value="Visible"/></DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
