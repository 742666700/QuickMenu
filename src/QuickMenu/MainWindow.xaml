<Window x:Class="QuickMenu.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:QuickMenu"
        Title="{DynamicResource S.App.Name}" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Width="820" Height="600" MinWidth="520" MinHeight="380" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Background="Transparent"
        FontFamily="{StaticResource BodyFont}" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" Deactivated="Window_Deactivated" Closing="Window_Closing">
  <Border x:Name="MaterialShell" BorderThickness="0" CornerRadius="0" Background="{DynamicResource BackdropBrush}">
    <Grid x:Name="RootGrid">
      <!-- Theme motion (AmbientScene) sits under everything and never takes input. Claude娘 stands in her own window (CompanionWindow). -->
      <Canvas x:Name="AmbientLayer" IsHitTestVisible="False" ClipToBounds="True"/>
      <Grid x:Name="ContentRoot">
        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
        <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <!-- Header: greeting, serif page titles, search and window actions. -->
        <Grid x:Name="HeaderBar" Background="Transparent" Margin="38,0,26,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6">
            <StackPanel x:Name="GreetingRow" Orientation="Horizontal" Margin="1,0,0,9">
              <Grid>
                <Control x:Name="GreetingSpark" Style="{StaticResource Spark}" Width="11" Height="11"/>
                <Image x:Name="GreetingAvatar" Width="22" Height="22" Margin="-5,-6,-6,-5" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
              </Grid>
              <TextBlock x:Name="GreetingText" Style="{StaticResource Heading}" FontWeight="Normal" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="DesktopNav" Content="{DynamicResource S.Nav.Desktop}" Style="{StaticResource TopNavButton}" Click="DesktopNav_Click" AutomationProperties.Name="{DynamicResource S.Nav.DesktopPage}"/>
              <Button x:Name="AppsNav" Content="{DynamicResource S.Nav.Apps}" Style="{StaticResource TopNavButton}" Click="AppsNav_Click" AutomationProperties.Name="{DynamicResource S.Nav.AppsPage}" Margin="26,0,0,0"/>
              <TextBlock x:Name="PageTitle" Visibility="Collapsed"/>
            </StackPanel>
          </StackPanel>
          <Grid x:Name="SearchHost" Grid.Column="1" Height="32" VerticalAlignment="Bottom" Margin="0,0,0,14">
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchField}" TextChanged="SearchBox_TextChanged" Padding="30,5,10,5" FontSize="12" AutomationProperties.Name="{DynamicResource S.Search.Desktop}"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="11,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchPlaceholder" Text="{DynamicResource S.Search.Desktop}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <!-- Window actions sit in the top-right corner, where Windows puts them. -->
        <StackPanel x:Name="WindowActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0">
          <Button x:Name="SettingsNav" Style="{StaticResource ToolbarButton}" Click="SettingsNav_Click" ToolTip="{DynamicResource S.Nav.Settings}" AutomationProperties.Name="{DynamicResource S.Nav.Settings}">
            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" Click="Hide_Click" ToolTip="{DynamicResource S.Nav.Hide}" AutomationProperties.Name="{DynamicResource S.Nav.Hide}">
            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
          </Button>
        </StackPanel>

        <!-- Pinned row: one line of pill buttons, hidden when nothing is pinned. -->
        <Grid x:Name="PinnedShelf" Grid.Row="1" Height="44" Margin="26,0,26,10">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- 26 + 13 puts the pin on the same 39px column as the greeting spark and the page titles. -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,14,0">
            <TextBlock x:Name="PinnedMark" Text="&#xE718;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="{DynamicResource S.Pinned.Title}" FontSize="12.5" Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
            <ItemsControl x:Name="PinnedItems" Focusable="False" PreviewMouseLeftButtonDown="Reorder_MouseDown" PreviewMouseMove="Reorder_MouseMove" PreviewMouseLeftButtonUp="Pinned_MouseLeftButtonUp" LostMouseCapture="Reorder_LostMouseCapture">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button x:Name="PinnedPill" Style="{StaticResource PinnedButton}" Tag="{Binding}" Click="Pinned_Click" PreviewMouseRightButtonDown="Pinned_RightClick" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}">
                    <StackPanel Orientation="Horizontal">
                      <!-- Rounded corners so square icons sit easily in the round pill; the pill's padding gives equal space on both sides. -->
                      <Grid Width="24" Height="24">
                        <Grid.Clip><RectangleGeometry Rect="0,0,24,24" RadiusX="6" RadiusY="6"/></Grid.Clip>
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource MissingIconGlyph}" FontSize="14" HorizontalAlignment="Center"/>
                        <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                      </Grid>
                      <TextBlock Text="{Binding Name}" FontSize="13" MaxWidth="140" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Category tabs and sort -->
        <Grid x:Name="CategoryToolbar" Grid.Row="2" Margin="26,0,26,15">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Border Grid.ColumnSpan="4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"/>
          <WrapPanel x:Name="CategoryBar">
            <WrapPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource CategoryButton}"/></WrapPanel.Resources>
            <Button Content="{DynamicResource S.Tab.All}" Tag="All" Click="Category_Click"/>
            <Button x:Name="GamesCategory" Content="{DynamicResource S.Tab.Games}" Tag="Games" Click="Category_Click"/>
            <Button x:Name="AiCategory" Content="{DynamicResource S.Tab.AiTools}" Tag="AiTools" Click="Category_Click"/>
            <Button x:Name="CategoryMenuButton" Content="{DynamicResource S.Tab.Categories}" Click="CategoryMenu_Click"/>
            <Button x:Name="OfficeCategory" Content="{DynamicResource S.Tab.Office}" Tag="Office" Click="Category_Click" MouseEnter="Office_MouseEnter" MouseLeave="Office_MouseLeave"/>
          </WrapPanel>
          <TextBlock x:Name="HeaderDetail" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,8"/>
          <Button x:Name="RefreshButton" Grid.Column="2" Content="{DynamicResource S.Tab.Refresh}" Style="{StaticResource CategoryButton}" Click="RefreshDesktop_Click" AutomationProperties.Name="{DynamicResource S.Tab.RefreshName}" ToolTip="{DynamicResource S.Tab.RefreshTip}"/>
          <Button x:Name="SortButton" Grid.Column="3" Style="{StaticResource CategoryButton}" Click="Sort_Click" AutomationProperties.Name="{DynamicResource S.Tab.SortName}" ToolTip="{DynamicResource S.Tab.SortTip}"/>
        </Grid>
        <Popup x:Name="OfficePopup" PlacementTarget="{Binding ElementName=OfficeCategory}" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade">
          <Border Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="6" MouseEnter="Office_MouseEnter" MouseLeave="Office_MouseLeave">
            <StackPanel x:Name="OfficeSubcategories" Orientation="Horizontal">
              <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource CategoryButton}"/></StackPanel.Resources>
              <Button Content="{DynamicResource S.Office.Documents}" Tag="Documents" Click="Category_Click"/>
              <Button Content="{DynamicResource S.Office.Spreadsheets}" Tag="Spreadsheets" Click="Category_Click"/>
              <Button Content="{DynamicResource S.Office.Presentations}" Tag="Presentations" Click="Category_Click"/>
            </StackPanel>
          </Border>
        </Popup>

        <!-- Page content. A page that runs on past the bottom fades out over its last few pixels (PageHost_ScrollChanged). -->
        <Grid x:Name="PageHost" Grid.Row="3" Margin="20,0,20,26" ScrollViewer.ScrollChanged="PageHost_ScrollChanged" SizeChanged="PageHost_SizeChanged">
          <ListBox x:Name="DesktopList" ItemContainerStyle="{StaticResource DesktopTile}" ItemTemplate="{StaticResource DesktopItemTemplate}" SelectionChanged="DesktopList_SelectionChanged" PreviewMouseLeftButtonDown="Reorder_MouseDown" PreviewMouseMove="Reorder_MouseMove" PreviewMouseLeftButtonUp="DesktopList_MouseLeftButtonUp" LostMouseCapture="Reorder_LostMouseCapture" PreviewMouseRightButtonDown="DesktopList_MouseRightButtonDown" AutomationProperties.Name="{DynamicResource S.List.Desktop}">
            <ListBox.GroupStyle>
              <GroupStyle HidesIfEmpty="True">
                <GroupStyle.Panel><ItemsPanelTemplate><local:DesktopColumnsPanel/></ItemsPanelTemplate></GroupStyle.Panel>
                <GroupStyle.ContainerStyle>
                  <Style TargetType="GroupItem">
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                          <StackPanel Margin="6,0,6,12">
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="6,0,6,8" Padding="0,0,0,10">
                              <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" FontSize="17"/>
                            </Border>
                            <ItemsPresenter/>
                          </StackPanel>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </GroupStyle.ContainerStyle>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemsPanel><ItemsPanelTemplate><local:ColumnItemsPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <ListBox x:Name="AppsList" ItemContainerStyle="{StaticResource AppRow}" ItemTemplate="{StaticResource AppRowTemplate}" Visibility="Collapsed" SelectionChanged="AppsList_SelectionChanged" MouseDoubleClick="AppsList_MouseDoubleClick" AutomationProperties.Name="{DynamicResource S.List.Apps}">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" Margin="12,8,0,8" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemsPanel><ItemsPanelTemplate><local:ColumnItemsPanel MinColumnWidth="340"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          </ListBox>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <Control Style="{StaticResource Spark}" Width="22" Height="22" Opacity="0.8" HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyText" Text="{DynamicResource S.Empty.Loading}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
          </StackPanel>

          <!-- Settings: a section list on the left jumps within one scrolling page. Every change applies at once. -->
          <StackPanel x:Name="SettingsSections" Width="112" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-20,2,0,0" Visibility="{Binding Visibility, ElementName=SettingsPanel}">
            <StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource SectionButton}"/></StackPanel.Resources>
            <Button Content="{DynamicResource S.Settings.General}" Tag="SectionGeneral" Click="SettingsSection_Click"/>
            <Button Content="{DynamicResource S.Settings.Appearance}" Tag="SectionAppearance" Click="SettingsSection_Click"/>
            <Button Content="{DynamicResource S.Settings.Games}" Tag="SectionGames" Click="SettingsSection_Click"/>
            <Button Content="{DynamicResource S.Settings.Categories}" Tag="SectionCategories" Click="SettingsSection_Click"/>
            <Button Content="{DynamicResource S.Settings.About}" Tag="SectionAbout" Click="SettingsSection_Click"/>
          </StackPanel>
          <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="100,0,0,0" ScrollChanged="SettingsPanel_ScrollChanged">
            <StackPanel x:Name="SettingsContent" Margin="0,0,10,16">
              <TextBlock x:Name="SectionGeneral" Text="{DynamicResource S.Settings.General}" Style="{StaticResource SettingsHeading}" Margin="6,2,0,10"/>
              <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="22,4,22,4">
                <StackPanel>
                  <!-- Free-software notice: the app is only ever given away, so anyone who sold it should refund. -->
                  <Grid x:Name="FreeNotice" Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Notice}" FontWeight="SemiBold" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{DynamicResource S.Settings.NoticeFree}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                      <TextBlock Text="{DynamicResource S.Settings.NoticeRefund}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Text="{DynamicResource S.Settings.Language}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <!-- Same as Windows, 简体中文, English: each language names itself. -->
                    <ComboBox x:Name="LanguagePicker" Grid.Column="1" Padding="10,7" AutomationProperties.Name="语言 Language">
                      <ComboBoxItem Content="{DynamicResource S.Settings.LanguageSystem}"/><ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/>
                    </ComboBox>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Hotkey}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,9,0,0"/>
                    <StackPanel Grid.Column="1">
                      <TextBox x:Name="HotkeyBox" IsReadOnly="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" AutomationProperties.Name="{DynamicResource S.Settings.HotkeyName}"/>
                      <TextBlock Text="{DynamicResource S.Settings.HotkeyHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,18,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Greeting}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1">
                      <CheckBox x:Name="WorldClockCheck" Content="{DynamicResource S.Settings.ShowClock}" AutomationProperties.Name="{DynamicResource S.Settings.ShowClock}"/>
                      <StackPanel x:Name="ClockOptions" Margin="0,12,0,0">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{DynamicResource S.Settings.ClockLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="1,0,10,0"/>
                          <TextBox x:Name="ClockLabelBox" Grid.Column="1" MaxLength="12" AutomationProperties.Name="{DynamicResource S.Settings.ClockLabelName}"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="118"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{DynamicResource S.Settings.SecondClock}" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="1,0,10,0"/>
                          <ComboBox x:Name="SecondClockPicker" Grid.Column="1" Padding="10,7" AutomationProperties.Name="{DynamicResource S.Settings.SecondClockName}"/>
                          <TextBox x:Name="SecondClockLabelBox" Grid.Column="2" MaxLength="12" Margin="8,0,0,0" AutomationProperties.Name="{DynamicResource S.Settings.SecondClockLabelName}"/>
                        </Grid>
                        <TextBlock x:Name="ClockPreview" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,18,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Startup}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1">
                      <CheckBox x:Name="StartupCheck" Content="{DynamicResource S.Settings.StartupCheck}" AutomationProperties.Name="{DynamicResource S.Settings.StartupCheck}"/>
                      <TextBlock Text="{DynamicResource S.Settings.StartupHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,18,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Gamepad}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1">
                      <CheckBox x:Name="GamepadCheck" Content="{DynamicResource S.Settings.GamepadCheck}" AutomationProperties.Name="{DynamicResource S.Settings.GamepadCheck}"/>
                      <TextBlock Text="{DynamicResource S.Settings.GamepadHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock x:Name="SectionAppearance" Text="{DynamicResource S.Settings.Appearance}" Style="{StaticResource SettingsHeading}"/>
              <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="22,4,22,4">
                <StackPanel>
                  <Grid Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Theme}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,9,0,0"/>
                    <StackPanel Grid.Column="1">
                      <ComboBox x:Name="ThemePicker" Padding="10,7" SelectedIndex="0" AutomationProperties.Name="{DynamicResource S.Settings.ThemeName}">
                        <!-- Order matches MainWindow.ThemeChoices. -->
                        <ComboBoxItem Content="{DynamicResource S.Theme.System}"/><ComboBoxItem Content="{DynamicResource S.Theme.OledDay}"/><ComboBoxItem Content="{DynamicResource S.Theme.Oled}"/><ComboBoxItem Content="{DynamicResource S.Theme.Cream}"/><ComboBoxItem Content="{DynamicResource S.Theme.ChatGpt}"/><ComboBoxItem Content="{DynamicResource S.Theme.DeepSeek}"/><ComboBoxItem Content="{DynamicResource S.Theme.Gemini}"/>
                      </ComboBox>
                    </StackPanel>
                  </Grid>
                  <Border Height="1" Background="{DynamicResource BorderBrush}"/>
                  <Grid Margin="0,16,0,18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource S.Settings.Character}" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,9,0,0"/>
                    <StackPanel Grid.Column="1">
                      <!-- "不显示" first, then MainWindow fills in every character. -->
                      <ComboBox x:Name="CharacterPicker" Padding="10,7" AutomationProperties.Name="{DynamicResource S.Settings.Character}"/>
                      <TextBlock Text="{DynamicResource S.Settings.CharacterHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                      <CheckBox x:Name="FollowThemeCheck" Content="{DynamicResource S.Settings.FollowTheme}" Margin="0,14,0,0" AutomationProperties.Name="{DynamicResource S.Settings.FollowThemeName}"/>
                      <TextBlock Text="{DynamicResource S.Settings.FollowThemeHint}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <TextBlock x:Name="SectionGames" Text="{DynamicResource S.Settings.Games}" Style="{StaticResource SettingsHeading}"/>
              <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="22,18,22,18">
                <StackPanel>
                  <TextBlock Text="{DynamicResource S.Settings.GamesIntro}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,0"/>
                  <UniformGrid x:Name="GameSourcesPanel" Columns="2" Margin="0,10,0,0"/>
                  <TextBlock Text="{DynamicResource S.Settings.GamesFolders}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,6,0,0" TextWrapping="Wrap"/>
                  <StackPanel x:Name="GameLibraryRows" Margin="0,8,0,0"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Content="{DynamicResource S.Settings.AddFolder}" Click="AddGameFolder_Click" Margin="0,0,8,0"/>
                    <Button Content="{DynamicResource S.Settings.AddGame}" Click="AddGame_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RescanGamesButton" Content="{DynamicResource S.Settings.Rescan}" Click="RescanGames_Click"/>
                  </WrapPanel>
                  <TextBlock x:Name="GameLibrarySummary" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <TextBlock x:Name="SectionCategories" Text="{DynamicResource S.Settings.Categories}" Style="{StaticResource SettingsHeading}"/>
              <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="22,18,22,18">
                <StackPanel>
                  <TextBlock Text="{DynamicResource S.Settings.CategoriesIntro}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,0,0,0" TextWrapping="Wrap"/>
                  <StackPanel x:Name="CategoryRows" Margin="0,12,0,0"/>
                  <Button Content="{DynamicResource S.Settings.NewCategory}" Click="NewCategory_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>

              <TextBlock x:Name="SectionAbout" Text="{DynamicResource S.Settings.About}" Style="{StaticResource SettingsHeading}"/>
              <Border Background="{DynamicResource CardBrush}" CornerRadius="16" Padding="22,18,22,18">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Control Style="{StaticResource Spark}" Width="13" Height="13"/>
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="ProjectLinkRow" FontSize="12" Margin="1,10,0,0" TextWrapping="Wrap">
                    <Run Text="{DynamicResource S.Settings.ProjectHome}" Foreground="{DynamicResource MutedBrush}"/><Hyperlink x:Name="ProjectLink" Click="WebLink_Click" Foreground="{DynamicResource AccentBrush}"><Run x:Name="ProjectLinkText"/></Hyperlink>
                  </TextBlock>
                  <TextBlock x:Name="ContactRow" FontSize="12" Margin="1,6,0,0" TextWrapping="Wrap">
                    <Run Text="{DynamicResource S.Settings.Contact}" Foreground="{DynamicResource MutedBrush}"/><Hyperlink x:Name="ContactLink" Click="WebLink_Click" Foreground="{DynamicResource AccentBrush}"><Run x:Name="ContactLinkText"/></Hyperlink>
                  </TextBlock>
                  <TextBlock Text="{DynamicResource S.Settings.License}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,8,0,0" TextWrapping="Wrap"/>
                  <TextBlock Text="{DynamicResource S.Settings.FanArt}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,6,0,0" TextWrapping="Wrap"/>
                  <Button Content="{DynamicResource S.Settings.OpenData}" Click="OpenDataFolder_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="34,-14,25,14" TextWrapping="Wrap"/>

      </Grid>

      <!-- Confirmation and window picker dialog -->
      <Grid x:Name="Overlay" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="DialogBorder" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="28,26,28,24" Width="372" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <StackPanel>
            <TextBlock x:Name="DialogTitle" Style="{StaticResource Heading}" FontSize="20" TextWrapping="Wrap"/>
            <TextBlock x:Name="DialogDescription" Text="{DynamicResource S.Dialog.UnsavedLost}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="DialogDetail" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
            <ListBox x:Name="WindowPicker" MaxHeight="170" Margin="0,14,0,0" DisplayMemberPath="Title" Visibility="Collapsed" ItemContainerStyle="{StaticResource AppRow}"/>
            <Grid Margin="0,24,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Button x:Name="DialogCancel" Content="{DynamicResource S.Dialog.Cancel}" Click="DialogCancel_Click" Margin="0,0,5,0" Padding="14,8"/>
              <Button x:Name="DialogConfirm" Grid.Column="1" Content="{DynamicResource S.Dialog.EndProcess}" Click="DialogConfirm_Click" Background="{DynamicResource DangerBrush}" Foreground="{DynamicResource OnActionBrush}" FontWeight="SemiBold" BorderThickness="0" Margin="5,0,0,0" Padding="14,8"/>
            </Grid>
          </StackPanel>
        </Border>
        <!-- Category editor: a custom category's name and rules, or one built-in rule list. -->
        <Border x:Name="CategoryEditor" Visibility="Collapsed" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="28,26,28,24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
          <StackPanel>
            <TextBlock x:Name="CategoryEditorTitle" Style="{StaticResource Heading}" FontSize="20" TextWrapping="Wrap"/>
            <StackPanel x:Name="CategoryNameRow" Margin="0,16,0,0">
              <TextBlock Text="{DynamicResource S.Editor.Name}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
              <TextBox x:Name="CategoryNameBox" Margin="0,6,0,0" MaxLength="20" AutomationProperties.Name="{DynamicResource S.Editor.NameField}"/>
            </StackPanel>
            <StackPanel x:Name="CategoryKeywordsRow" Margin="0,14,0,0">
              <TextBlock x:Name="CategoryKeywordsLabel" Text="{DynamicResource S.Category.WordsLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBox x:Name="CategoryKeywordsBox" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource S.Category.WordsLabel}"/>
            </StackPanel>
            <StackPanel x:Name="CategoryExtensionsRow" Margin="0,14,0,0">
              <TextBlock Text="{DynamicResource S.Editor.Extensions}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
              <TextBox x:Name="CategoryExtensionsBox" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource S.Editor.ExtensionsField}"/>
            </StackPanel>
            <StackPanel x:Name="CategoryPathRow" Margin="0,14,0,0">
              <TextBlock x:Name="CategoryPathLabel" Text="{DynamicResource S.Category.PathLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBox x:Name="CategoryPathBox" Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource S.Editor.PathField}"/>
            </StackPanel>
            <TextBlock Text="{DynamicResource S.Editor.Hint}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <CheckBox x:Name="CategoryTabCheck" Content="{DynamicResource S.Editor.ShowTab}" Margin="0,14,0,0"/>
            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Button x:Name="CategoryRestore" Content="{DynamicResource S.Editor.Restore}" Click="CategoryEditorRestore_Click" Padding="14,8"/>
              <Button Grid.Column="2" Content="{DynamicResource S.Dialog.Cancel}" Click="CategoryEditorCancel_Click" Padding="18,8" Margin="0,0,8,0"/>
              <Button Grid.Column="3" Content="{DynamicResource S.Editor.Save}" Style="{StaticResource PrimaryButton}" Click="CategoryEditorSave_Click"/>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
